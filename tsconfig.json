{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["app/**/*.ts", "vite.config.ts"]
}
